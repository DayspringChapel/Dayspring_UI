# DaySpring Chapel website - environment variables.
#
# Copy to `.env.local` for local development; on Vercel (or any host) set the same keys in the
# project's environment settings. Never commit a real `.env.local`.
# Variables starting with NEXT_PUBLIC_ are embedded in the browser bundle - never put secrets there.

# ---- Backend API (required) ----------------------------------------------------------------------
# Base URL of the DaySpring API, no trailing slash. If unset, the app falls back to the hosted
# default baked into lib/apiClient.js - set this when you move the backend to another server.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8080
NEXT_PUBLIC_API_VERSION=v1

# ---- Website features (all optional; server-side only) -------------------------------------------
# YouTube Data API key used by /api/youtube-feed to show the latest sermons on the landing page.
YOUTUBE_API_KEY=

# Announcement posting from /api/announce. Leave blank for any platform you don't use.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

IG_USER_ID=
IG_ACCESS_TOKEN=

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Comma-separated recipient numbers
WHATSAPP_RECIPIENT_NUMBERS=
